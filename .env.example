VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-browser-safe-key
# Legacy projects can keep using VITE_SUPABASE_ANON_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_server-only-key-for-account-provisioning
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.

# URL công khai của NestJS trên VPS, ví dụ https://api.clinic.example.com/api
VITE_API_BASE_URL=
# Chỉ bật khi phát triển cục bộ; production luôn xác thực qua Supabase Auth.
VITE_ENABLE_DEMO_AUTH=false
# Chỉ cho phép origin frontend gọi API NestJS (phân cách nhiều URL bằng dấu phẩy).
CORS_ORIGINS=http://localhost:5173
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic_hub
POSTGRES_USER=clinic_hub
POSTGRES_PASSWORD=change-me
