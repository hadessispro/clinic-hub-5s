VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-browser-safe-key
# Legacy projects can keep using VITE_SUPABASE_ANON_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_server-only-key-for-account-provisioning
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.

# Shadow infrastructure. Supabase remains the production source until an
# explicitly approved cutover.
POSTGRES_DB=clinic_hub
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=generate-a-long-random-secret
REDIS_PASSWORD=generate-a-long-random-secret
JWT_SECRET=generate-a-long-random-secret
MIGRATION_SECRET=generate-a-long-random-secret
