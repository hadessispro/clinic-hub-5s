{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/sheet-sync", "schedule": "0 1 * * *" }],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self)"
        }
      ]
    }
  ]
}
